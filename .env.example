# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=

# ===== Database =====
# Dev (по умолчанию, файл создаётся автоматически):
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Prod (PostgreSQL + pgvector):
# DATABASE_URL=postgresql+asyncpg://bot:secret@db:5432/aiemployee

# ===== Redis (опционально: FSM storage + распределённый throttle) =====
# REDIS_URL=redis://redis:6379/0

# ===== LLM (OpenAI-совместимый API) =====
# Пустой ключ -> автоматический MockProvider (dev/test/CI без внешних зависимостей)
LLM_API_KEY=
# GLM / Zhipu:
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Fallback-провайдер (опционально):
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60
# Принудительный mock (для локальной отладки): 1
LLM_MOCK=0

# ===== Embeddings (RAG, v2) =====
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024

# ===== Контекст =====
CONTEXT_WINDOW=20
CONTEXT_TOKEN_BUDGET=3000
SUMMARY_TRIGGER_MESSAGES=40

# ===== Тарифы и лимиты (§4 архитектуры) =====
PERIOD_DAYS=30
FREE_LIMIT=30
PRO_LIMIT=500
BUSINESS_LIMIT=2000
PRO_PRICE_STARS=100
BUSINESS_PRICE_STARS=250

# ===== Ограничения и безопасность =====
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_LEN=4000
ADMIN_IDS=
DEFAULT_TZ=UTC

# ===== Прочее =====
LOG_LEVEL=INFO