# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=

# ===== Database =====
# Dev (по умолчанию, файл создаётся автоматически):
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Prod (PostgreSQL + pgvector; имя сервиса в compose — postgres):
# DATABASE_URL=postgresql+asyncpg://bot:secret@postgres:5432/aiemployee

# ===== Redis (опционально: FSM storage + распределённый throttle) =====
# REDIS_URL=redis://redis:6379/0

# ===== LLM ($0/мес: бесплатные провайдеры, OpenAI-совместимый API) =====
# Провайдеры: groq | openrouter | openai | glm (пресет задаёт base_url и модель)
LLM_PROVIDER=groq
LLM_API_KEY=
#   Groq (бесплатный tier, очень быстрый): ключ на https://console.groq.com/keys
#   OpenRouter (модели с суффиксом :free): ключ на https://openrouter.ai/keys
# Пресет по умолчанию для groq: llama-3.3-70b-versatile @ https://api.groq.com/openai/v1
# Переопределить модель/base_url можно явно:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-2-9b-it:free
# Fallback-провайдер (опционально, например Groq -> OpenRouter):
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60
# Принудительный mock (локальная отладка без сети): 1
LLM_MOCK=0

# ===== Векторный поиск RAG (локально, $0) =====
# sqlite (по умолчанию, встроенный cosine-поиск) | chroma (локальный ChromaDB в ./chroma_db,
# рекомендован с Groq/OpenRouter — там нет embeddings API)
VECTOR_STORE=sqlite
CHROMA_DIR=./chroma_db

# ===== Контекст =====
CONTEXT_WINDOW=20
CONTEXT_TOKEN_BUDGET=3000
SUMMARY_TRIGGER_MESSAGES=40

# ===== Тарифы и лимиты (§4 архитектуры) =====
PERIOD_DAYS=30
FREE_LIMIT=30
PRO_LIMIT=500
BUSINESS_LIMIT=2000
PRO_PRICE_STARS=100
BUSINESS_PRICE_STARS=250

# ===== Ограничения и безопасность =====
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_LEN=4000
ADMIN_IDS=
DEFAULT_TZ=UTC

# ===== Режим приёма апдейтов =====
# False = long polling (dev, без домена) | True = webhook (prod, нужен https-домен)
WEBHOOK_MODE=0
WEBHOOK_BASE_URL=
WEBHOOK_SECRET_PATH=tg-webhook
# Случайная строка для заголовка X-Telegram-Bot-Api-Secret-Token (сгенерируйте: openssl rand -hex 32)
WEBHOOK_SECRET_TOKEN=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# ===== Docker compose (prod-профиль) =====
POSTGRES_PASSWORD=

# ===== Прочее =====
LOG_LEVEL=INFO