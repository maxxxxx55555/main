[Unit]
Description=Ravencoin Miner (T-Rex)
After=network.target

[Service]
Type=simple
User=miner
Group=miner
WorkingDirectory=/opt/trex
EnvironmentFile=/etc/miner/config/.env

# Start command
# T-Rex flags:
#   -a kawpow  : KawPow algorithm (Ravencoin)
#   -u         : wallet address from .env
#   -p         : pool password from .env
#   -w         : worker name from .env
#   --api-port : API port for monitoring
#   -d         : dev mode (detailed stats)
#   ${EXTRA_FLAGS} : additional flags (can be empty)
#   ${POOL_URL} : pool address
ExecStart=/opt/trex/trex -a kawpow -u ${WALLET_ADDRESS} -p ${POOL_PASSWORD} -w ${WORKER_NAME} --api-port ${API_PORT} -d ${EXTRA_FLAGS} ${POOL_URL}

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Resource limits (adjust based on your system)
MemoryMax=8G
CPUQuota=800%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=miner

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/miner /opt/trex

[Install]
WantedBy=multi-user.target