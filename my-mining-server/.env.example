# Miner Wallet Address (your RVN address)
WALLET_ADDRESS=your_rvn_wallet_address_here

# Pool URL (2miners Ravencoin pool)
POOL_URL=rvn.2miners.com:4444

# Miner Worker Name (optional, for multi-GPU setups)
WORKER_NAME=worker1

# T-Rex Miner Settings
# --api-port: Web interface port (default 4068)
API_PORT=4068

# Power limits (percentage, 0-100)
# Set to 0 for auto/no limit
POWER_LIMIT=85

# Temperature target (Celsius)
TEMP_TARGET=70

# Additional T-Rex flags (optional)
# Example: EXTRA_FLAGS="--kernel-config 1"
EXTRA_FLAGS=

# Pool password (usually 'x' or your pool password)
POOL_PASSWORD=x